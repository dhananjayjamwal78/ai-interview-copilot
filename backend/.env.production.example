APP_NAME=AI Interview Copilot Backend
APP_VERSION=0.1.0
APP_DESCRIPTION=Free and open-source AI interview preparation backend
DEBUG=False
ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
RUN_RELOAD=false
ENABLE_DOCS=false
ENABLE_OPENAPI=false
ENABLE_REDOC=false

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ai_interview_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://postgres:change-me@db:5432/ai_interview_copilot

MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

CORS_ALLOW_ORIGINS=https://your-frontend-domain.example
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
