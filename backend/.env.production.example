APP_NAME=AI Interview Copilot Backend
APP_VERSION=0.1.0
APP_DESCRIPTION=Free and open-source AI interview preparation backend
DEBUG=False
ENVIRONMENT=production
APP_HOST=0.0.0.0
APP_PORT=8000
RUN_RELOAD=false
ENABLE_DOCS=false
ENABLE_OPENAPI=false
ENABLE_REDOC=false

DATABASE_URL=postgresql+psycopg://postgres:change-me@your-railway-postgres-host:5432/railway

MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-replace-me
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_REQUEST_TIMEOUT_SECONDS=180
OPENROUTER_SITE_URL=https://your-streamlit-app.streamlit.app
OPENROUTER_APP_NAME=AI Interview Copilot

CORS_ALLOW_ORIGINS=https://your-streamlit-app.streamlit.app
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
