COMPOSE_PROJECT_NAME=ai-interview-copilot

# Backend application
APP_NAME=AI Interview Copilot Backend
APP_VERSION=0.1.0
APP_DESCRIPTION=Free and open-source AI interview preparation backend
DEBUG=true
ENVIRONMENT=development
APP_HOST=0.0.0.0
APP_PORT=8000
RUN_RELOAD=true
ENABLE_DOCS=true
ENABLE_OPENAPI=true
ENABLE_REDOC=false

# Frontend
FRONTEND_PORT=8501
BACKEND_URL=http://backend:8000
BACKEND_BROWSER_URL=http://localhost:8000

# PostgreSQL
POSTGRES_DB=ai_interview_copilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/ai_interview_copilot

# Free local LLM runtime
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT_SECONDS=180

# CORS
CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# Auth
SECRET_KEY=change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend API client
API_TIMEOUT_SECONDS=180
